{
  "name": "dot-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Render Graphviz DOT diagrams in static-site generators (VitePress, Eleventy, Docusaurus) — powered by the pure-TypeScript @knowvah/dot-engine.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "publish:local": "bash scripts/publish.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite@5": "^6.4.3",
      "esbuild@0.27": "^0.28.1"
    }
  }
}
