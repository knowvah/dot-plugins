{
  "name": "dot-vscode",
  "displayName": "DOT (Graphviz) Preview & Syntax",
  "description": "Syntax highlighting and live SVG preview for Graphviz DOT (.dot / .gv) files — powered by the pure-TypeScript @knowvah/dot-engine.",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "publisher": "knowvah",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0D0D1A",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "graphviz",
    "dot",
    "gv",
    "diagram",
    "preview",
    "svg"
  ],
  "homepage": "https://github.com/knowvah/dot-plugins/tree/main/packages/vscode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowvah/dot-plugins.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "DOT (Graphviz)",
      "properties": {
        "dot.preview.defaultEngine": {
          "type": "string",
          "enum": [
            "dot",
            "neato",
            "fdp",
            "sfdp",
            "circo",
            "twopi",
            "osage",
            "patchwork"
          ],
          "default": "dot",
          "markdownDescription": "Default layout engine for previews when a file has no `// engine: …` directive and no remembered per-file selection. A remembered selection (DOT: Select Layout Engine) and an in-file directive both override this."
        },
        "dot.preview.renderTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "markdownDescription": "Maximum time (in seconds) to render a `.dot`/`.gv` file preview before treating the graph as non-terminating and aborting to a timeout message. Rendering runs in a worker thread, so this never freezes the editor — raise it for very large graphs."
        },
        "dot.preview.useCurrentColor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Remap the diagram's black strokes and text to the editor's foreground color (`currentColor`) so the diagram follows your theme. Off by default: Graphviz renders diagrams on a white background, so black stays legible in every theme — with this on, a dark theme's near-white foreground would be nearly invisible on that white canvas. Enable it only if you also make the graph background transparent (e.g. `bgcolor=\"transparent\"` in the DOT source)."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/dot-preview.css"
    ],
    "languages": [
      {
        "id": "dot",
        "aliases": [
          "Graphviz (DOT)",
          "dot",
          "graphviz"
        ],
        "extensions": [
          ".dot",
          ".gv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dot",
        "scopeName": "source.dot",
        "path": "./syntaxes/dot.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dot.showPreview",
        "title": "Open Preview to the Side",
        "category": "DOT",
        "icon": "$(open-preview)"
      },
      {
        "command": "dot.selectEngine",
        "title": "Select Layout Engine",
        "category": "DOT",
        "icon": "$(list-selection)"
      },
      {
        "command": "dot.clearEngineOverride",
        "title": "Clear Remembered Engine Override",
        "category": "DOT"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == dot",
          "command": "dot.showPreview",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == dot",
          "command": "dot.selectEngine"
        }
      ],
      "commandPalette": [
        {
          "command": "dot.showPreview",
          "when": "resourceLangId == dot"
        },
        {
          "command": "dot.selectEngine",
          "when": "resourceLangId == dot"
        },
        {
          "command": "dot.clearEngineOverride",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dot.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == dot && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@knowvah/dot-core": "workspace:*",
    "@knowvah/dot-engine": "^1.2.5",
    "@knowvah/dot-markdown-it": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "markdown-it": "^14.3.0",
    "ovsx": "^1.0.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
