{
  "name": "@knowvah/dot-core",
  "version": "2.0.0",
  "description": "Framework-agnostic Graphviz DOT → SVG render engine for static-site plugins, powered by the pure-TypeScript @knowvah/dot-engine.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "graphviz",
    "dot",
    "svg",
    "@knowvah/dot-engine",
    "render"
  ],
  "homepage": "https://github.com/knowvah/dot-plugins/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowvah/dot-plugins.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    },
    "./element": {
      "import": "./dist/element/index.js",
      "types": "./dist/element/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@knowvah/dot-engine": ">=1.2.5"
  },
  "devDependencies": {
    "@knowvah/dot-engine": "^1.2.6",
    "@types/node": "^22.20.1",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
